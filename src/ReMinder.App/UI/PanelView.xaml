<UserControl x:Class="ReMinder.App.UI.PanelView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ReMinder.App.UI" Width="360" MaxHeight="560">
  <UserControl.Resources><BooleanToVisibilityConverter x:Key="Visibility"/></UserControl.Resources>
  <Border Background="{DynamicResource Surface}" CornerRadius="28" Padding="20">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center"><TextBlock FontSize="{DynamicResource HeadingSize}" FontWeight="Medium"><Run Text="Re"/><Run Text=":" Foreground="{DynamicResource Primary}"/><Run Text="minder"/></TextBlock><TextBlock Text="{Binding Date}" Style="{StaticResource Small}" Margin="0,4,0,0" Visibility="{Binding Expanded,Converter={StaticResource Visibility}}"/></StackPanel>
      <Button Grid.Column="1" Command="{Binding Menu}" Style="{StaticResource IconButton}" ToolTip="更多操作或展开面板" AutomationProperties.Name="更多操作或展开面板"><local:Icon Kind="more" Foreground="{DynamicResource Muted}"/></Button>
    </Grid>
    <Button Grid.Row="1" Command="{Binding Summary}" Background="{DynamicResource PrimaryContainer}" Foreground="{DynamicResource OnPrimaryContainer}" Padding="16" HorizontalContentAlignment="Stretch" Margin="0,0,0,16" Visibility="{Binding HasTasks,Converter={StaticResource Visibility}}" AutomationProperties.Name="编辑下一项截止任务">
      <StackPanel><StackPanel Orientation="Horizontal"><local:Icon Kind="clock" Width="16" Height="16" Margin="0,0,6,0" Foreground="{DynamicResource OnPrimaryContainer}"/><TextBlock Text="{Binding SummaryLabel}" FontSize="{DynamicResource SmallSize}" Foreground="{DynamicResource OnPrimaryContainer}"/></StackPanel><TextBlock Text="{Binding SummaryTitle}" Style="{StaticResource Title}" Foreground="{DynamicResource OnPrimaryContainer}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding SummaryTitle}"/><TextBlock Text="{Binding Countdown}" FontSize="{DynamicResource CountdownSize}" Foreground="{DynamicResource OnPrimaryContainer}" Margin="0,4,0,0"/><TextBlock Text="{Binding SummaryDate}" FontSize="{DynamicResource SmallSize}" Foreground="{DynamicResource OnPrimaryContainer}" Margin="0,6,0,0" Visibility="{Binding Expanded,Converter={StaticResource Visibility}}"/></StackPanel>
    </Button>
    <Grid Grid.Row="2" Margin="4,0,4,8" Visibility="{Binding Expanded,Converter={StaticResource Visibility}}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding PendingLabel}" Style="{StaticResource Small}"/><TextBlock Grid.Column="1" Text="{Binding OverdueLabel}" Style="{StaticResource Small}" Foreground="{DynamicResource Error}" Visibility="{Binding HasOverdue,Converter={StaticResource Visibility}}"/></Grid>
    <Grid Grid.Row="3" Visibility="{Binding Expanded,Converter={StaticResource Visibility}}">
      <ListBox x:Name="TaskList" ItemsSource="{Binding Tasks}" Background="Transparent" BorderThickness="0" Padding="0" MaxHeight="276" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" Visibility="{Binding HasTasks,Converter={StaticResource Visibility}}" AutomationProperties.Name="待办任务列表">
        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Focusable" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate><DataTemplate><Border Background="{DynamicResource Card}" CornerRadius="16" Padding="8,12" MinHeight="88"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Button Style="{StaticResource IconButton}" Command="{Binding DataContext.Complete,RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" ToolTip="完成任务" AutomationProperties.Name="{Binding Title,StringFormat=完成 {0}}"><local:Icon Kind="circle" Foreground="{DynamicResource Outline}" Width="22" Height="22"/></Button>
          <Button Grid.Column="1" Padding="4" Foreground="{DynamicResource OnSurface}" HorizontalContentAlignment="Stretch" Command="{Binding DataContext.Edit,RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding Title}"><StackPanel><TextBlock Text="{Binding Title}" Style="{StaticResource Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/><WrapPanel Margin="0,6,0,0"><TextBlock Text="{Binding Absolute}" Style="{StaticResource Small}" VerticalAlignment="Center" Margin="0,0,6,4"/><Border CornerRadius="12" Padding="6,3" Margin="0,0,0,4" Background="{Binding BadgeBackground}"><TextBlock Text="{Binding Compact}" FontSize="{DynamicResource SmallSize}" Foreground="{Binding BadgeForeground}"/></Border></WrapPanel></StackPanel></Button>
        </Grid></Border></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <StackPanel Margin="8,24" Visibility="{Binding Empty,Converter={StaticResource Visibility}}"><Border Background="{DynamicResource PrimaryContainer}" CornerRadius="20" Width="64" Height="64" HorizontalAlignment="Center" Margin="0,0,0,16"><local:Icon Kind="calendar" Width="28" Height="28" Foreground="{DynamicResource OnPrimaryContainer}"/></Border><TextBlock Text="{Binding EmptyTitle}" Style="{StaticResource Title}" TextAlignment="Center"/><TextBlock Text="{Binding EmptySubtitle}" Style="{StaticResource Small}" TextAlignment="Center" Margin="0,8,0,0" LineHeight="20"/></StackPanel>
    </Grid>
    <Grid Grid.Row="4" Margin="0,12,0,0" Visibility="{Binding Expanded,Converter={StaticResource Visibility}}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Command="{Binding New}" Style="{StaticResource PrimaryButton}" AutomationProperties.Name="新建任务"><StackPanel Orientation="Horizontal"><local:Icon Kind="plus" Foreground="{DynamicResource OnPrimary}" Margin="0,0,6,0"/><TextBlock Text="新建任务" Foreground="{DynamicResource OnPrimary}"/></StackPanel></Button><Button Grid.Column="2" Content="{Binding CompletedLabel}" Command="{Binding History}" Padding="8"/></Grid>
    <Button Grid.Row="5" Command="{Binding RetryDesktop}" Margin="0,8,0,0" Padding="8" Visibility="{Binding HasHostNotice,Converter={StaticResource Visibility}}"><TextBlock Text="{Binding HostNotice}" Style="{StaticResource Small}" Foreground="{DynamicResource Error}"/></Button>
    <Border x:Name="Toast" Grid.RowSpan="6" Background="{DynamicResource Inverse}" CornerRadius="16" Padding="10" VerticalAlignment="Bottom" Margin="-8,0,-8,0" Visibility="Collapsed"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="ToastText" TextWrapping="Wrap" Foreground="{DynamicResource OnInverse}" FontSize="{DynamicResource SmallSize}" VerticalAlignment="Center"/><Button x:Name="UndoButton" Grid.Column="1" Command="{Binding Undo}" Foreground="{DynamicResource OnInverse}" Padding="8" AutomationProperties.Name="撤销"><TextBlock Text="撤销" Foreground="{DynamicResource OnInverse}"/></Button><Button x:Name="DismissToast" Grid.Column="2" Style="{StaticResource IconButton}" AutomationProperties.Name="关闭提示"><local:Icon Kind="close" Foreground="{DynamicResource OnInverse}" Width="16" Height="16"/></Button></Grid></Border>
  </Grid>
  </Border>
</UserControl>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ReMinder.App.UI" xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="CalendarStyles.xaml"/></ResourceDictionary.MergedDictionaries>
  <Style TargetType="Window"><Setter Property="FontFamily" Value="Microsoft YaHei UI, Microsoft YaHei, Segoe UI"/><Setter Property="FontSize" Value="{DynamicResource BodySize}"/><Setter Property="Foreground" Value="{DynamicResource OnSurface}"/></Style>
  <Style TargetType="TextBlock"><Setter Property="FontSize" Value="{DynamicResource BodySize}"/><Setter Property="Foreground" Value="{DynamicResource OnSurface}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="Small" TargetType="TextBlock"><Setter Property="FontSize" Value="{DynamicResource SmallSize}"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="Title" TargetType="TextBlock"><Setter Property="FontSize" Value="{DynamicResource TitleSize}"/><Setter Property="FontWeight" Value="Medium"/><Setter Property="Foreground" Value="{DynamicResource OnSurface}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style TargetType="Button">
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="local:Motion.Interactive" Value="True"/>
    <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource Primary}"/><Setter Property="FontSize" Value="{DynamicResource BodySize}"/><Setter Property="FontWeight" Value="Medium"/><Setter Property="Padding" Value="16,8"/><Setter Property="MinHeight" Value="40"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Grid Background="Transparent">
      <Grid x:Name="Surface" RenderTransformOrigin="0.5,0.5"><Grid.RenderTransform><ScaleTransform/></Grid.RenderTransform>
      <Border x:Name="Base" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="20"/>
      <Border x:Name="State" Background="{TemplateBinding Foreground}" Opacity="0" CornerRadius="20"/>
      <Canvas x:Name="RippleHost" IsHitTestVisible="False"/>
      <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
      </Grid>
      <Border x:Name="Ring" Margin="2" BorderBrush="{TemplateBinding Foreground}" BorderThickness="1.5" CornerRadius="18" Visibility="Collapsed" IsHitTestVisible="False"/>
      </Grid><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Ring" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/><Setter Property="Cursor" Value="Arrow"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Control"><Setter Property="FocusVisualStyle" Value="{x:Null}"/></Style>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{DynamicResource Primary}"/><Setter Property="Foreground" Value="{DynamicResource OnPrimary}"/></Style>
  <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{DynamicResource Raised}"/><Setter Property="Foreground" Value="{DynamicResource OnSurface}"/></Style>
  <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Width" Value="40"/><Setter Property="Height" Value="40"/><Setter Property="Padding" Value="8"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/></Style>
  <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type Control}}"><Setter Property="local:TextFieldMotion.Enabled" Value="True"/><Setter Property="FontSize" Value="{DynamicResource BodySize}"/><Setter Property="Foreground" Value="{DynamicResource OnSurface}"/><Setter Property="Background" Value="Transparent"/><Setter Property="CaretBrush" Value="{DynamicResource Primary}"/><Setter Property="BorderBrush" Value="{DynamicResource Outline}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12"/><Setter Property="MinHeight" Value="48"/><Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Grid>
      <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12"><Grid>
        <Border x:Name="FocusTint" Background="{DynamicResource Primary}" CornerRadius="11" Opacity="0" IsHitTestVisible="False"/>
        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
      </Grid></Border>
      <Border x:Name="FocusOutline" BorderBrush="{DynamicResource Primary}" BorderThickness="2" CornerRadius="12" Opacity="0" IsHitTestVisible="False"/>
      </Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="CheckBox">
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="local:Motion.Interactive" Value="True"/><Setter Property="Foreground" Value="{DynamicResource OnSurface}"/><Setter Property="FontSize" Value="{DynamicResource BodySize}"/><Setter Property="MinHeight" Value="40"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Padding" Value="8,0,0,0"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid x:Name="Surface" Width="40" Height="40" RenderTransformOrigin="0.5,0.5"><Grid.RenderTransform><ScaleTransform/></Grid.RenderTransform>
        <Border x:Name="FocusHalo" Background="{DynamicResource Primary}" CornerRadius="20" Opacity="0" IsHitTestVisible="False"/>
        <Border x:Name="State" Background="{DynamicResource Primary}" CornerRadius="20" Opacity="0"/>
        <Canvas x:Name="RippleHost" IsHitTestVisible="False"/>
        <Border x:Name="CheckBorder" Width="18" Height="18" CornerRadius="4" Background="Transparent" BorderThickness="1.5" BorderBrush="{DynamicResource Outline}"/>
        <Border x:Name="CheckFill" Width="18" Height="18" CornerRadius="4" Background="{DynamicResource Primary}" Opacity="0"/>
        <Path x:Name="Tick" Data="M 4,9 L 8,13 L 15,5" Stroke="{DynamicResource OnPrimary}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" StrokeDashArray="10 10" StrokeDashOffset="10" Opacity="0" Width="18" Height="18"/>
      </Grid>
      <ContentPresenter Grid.Column="1" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
      </Grid><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusHalo" Property="Opacity" Value="0.12"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="DatePicker">
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="local:TextFieldMotion.Enabled" Value="True"/>
    <Setter Property="Foreground" Value="{DynamicResource OnSurface}"/><Setter Property="Background" Value="{DynamicResource Card}"/><Setter Property="BorderBrush" Value="{DynamicResource Outline}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="{DynamicResource BodySize}"/><Setter Property="MinHeight" Value="48"/><Setter Property="CalendarStyle" Value="{StaticResource MaterialCalendar}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DatePicker"><Grid x:Name="PART_Root">
      <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12"/>
      <Border x:Name="FocusTint" Background="{DynamicResource Primary}" CornerRadius="12" Opacity="0" IsHitTestVisible="False"/>
      <Grid Margin="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
        <DatePickerTextBox x:Name="PART_TextBox" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" Background="Transparent" BorderThickness="0" Padding="12" MinHeight="46" local:TextFieldMotion.Enabled="False" FocusVisualStyle="{x:Null}"/>
        <Button x:Name="PART_Button" Grid.Column="1" Style="{StaticResource IconButton}" VerticalAlignment="Center" AutomationProperties.Name="打开日历" ToolTip="选择日期"><local:Icon Kind="calendar" Width="24" Height="24"/></Button>
      </Grid>
      <Border x:Name="FocusOutline" BorderBrush="{DynamicResource Primary}" BorderThickness="2" CornerRadius="12" Opacity="0" IsHitTestVisible="False"/>
      <Popup x:Name="PART_Popup" Placement="Bottom" PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" AllowsTransparency="True" StaysOpen="False" Focusable="False"/>
      </Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type Control}}"><Setter Property="FontSize" Value="{DynamicResource BodySize}"/><Setter Property="Foreground" Value="{DynamicResource OnSurface}"/><Setter Property="Background" Value="{DynamicResource Card}"/><Setter Property="BorderBrush" Value="{DynamicResource Outline}"/><Setter Property="MinHeight" Value="44"/><Setter Property="Padding" Value="12,8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
    <ToggleButton local:Motion.Interactive="True" Focusable="False" IsChecked="{Binding IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Grid x:Name="Surface" Background="Transparent" RenderTransformOrigin="0.5,0.5"><Grid.RenderTransform><ScaleTransform/></Grid.RenderTransform><Border x:Name="Box" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Outline}" BorderThickness="1" CornerRadius="12"><Grid><Path Data="M 0,0 L 4,4 L 8,0" Stroke="{DynamicResource Muted}" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"/></Grid></Border><Border x:Name="State" Background="{DynamicResource Primary}" CornerRadius="12" Opacity="0" IsHitTestVisible="False"/></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Primary}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template></ToggleButton>
    <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="12,8,34,8" VerticalAlignment="Center" IsHitTestVisible="False"/>
    <Border x:Name="Focus" BorderBrush="{DynamicResource Primary}" BorderThickness="2" CornerRadius="12" Visibility="Collapsed" IsHitTestVisible="False"/>
    <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border local:Motion.EnterOnLoad="True" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Outline}" BorderThickness="1" CornerRadius="12" MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}" Padding="4" Margin="0,4,0,4"><ScrollViewer MaxHeight="300" CanContentScroll="False"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup>
    </Grid><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Focus" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type Control}}"><Setter Property="Padding" Value="12,10"/><Setter Property="Foreground" Value="{DynamicResource OnSurface}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Item" CornerRadius="8" Padding="{TemplateBinding Padding}" Background="Transparent"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="{DynamicResource Raised}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="{DynamicResource PrimaryContainer}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="DatePickerTextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="Background" Value="{DynamicResource Card}"/><Setter Property="MinHeight" Value="44"/><Setter Property="Padding" Value="10"/></Style>
  <Style TargetType="Separator"><Setter Property="Background" Value="{DynamicResource Line}"/><Setter Property="Margin" Value="0,16"/><Setter Property="Height" Value="1"/></Style>
  <Style TargetType="ScrollViewer"><Setter Property="local:SmoothScroll.Enabled" Value="True"/><Setter Property="IsDeferredScrollingEnabled" Value="False"/></Style>
  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="14"/><Setter Property="Background" Value="Transparent"/><Setter Property="Focusable" Value="False"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="Transparent" SnapsToDevicePixels="True">
      <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}"><Track.Resources><sys:Double x:Key="{x:Static SystemParameters.VerticalScrollBarButtonHeightKey}">48</sys:Double><sys:Double x:Key="{x:Static SystemParameters.HorizontalScrollBarButtonWidthKey}">48</sys:Double></Track.Resources>
        <Track.DecreaseRepeatButton><RepeatButton x:Name="BeforeThumb" Command="ScrollBar.PageUpCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
        <Track.Thumb><Thumb x:Name="DragThumb" MinHeight="24" Cursor="Arrow"><Thumb.Template><ControlTemplate TargetType="Thumb"><Grid Background="Transparent"><Border x:Name="Grip" Background="{DynamicResource Outline}" Opacity="0.5" CornerRadius="3" Margin="4,0"/></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="Grip" Property="Background" Value="{DynamicResource Primary}"/><Setter TargetName="Grip" Property="Opacity" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
        <Track.IncreaseRepeatButton><RepeatButton x:Name="AfterThumb" Command="ScrollBar.PageDownCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
      </Track>
    </Grid><ControlTemplate.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/><Setter TargetName="DragThumb" Property="MinHeight" Value="0"/><Setter TargetName="DragThumb" Property="MinWidth" Value="24"/><Setter TargetName="BeforeThumb" Property="Command" Value="ScrollBar.PageLeftCommand"/><Setter TargetName="AfterThumb" Property="Command" Value="ScrollBar.PageRightCommand"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    <Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="14"/></Trigger></Style.Triggers>
  </Style>
</ResourceDictionary>
